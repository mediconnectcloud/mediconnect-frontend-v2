# Copy this file to .env. For local development against the NestJS
# backend (see the mediconnect-backend project), set VITE_API_URL to
# wherever that server is running - typically http://localhost:3000.
# Once deployed for real, this points at the API Gateway URL instead.

# Base URL of the backend API
VITE_API_URL=http://localhost:3000

# Cognito User Pool ID and App Client ID (from the AWS Cognito console) -
# not required yet; login is still dummy on both frontend and backend
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# AWS region the services are deployed in
VITE_REGION=ap-southeast-2
